{
  "style_id": "CO_VISUAL_V3",
  "style_version": 3,
  "status": "candidate",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "format": "long_form_16_9",
    "safe_margin_absolute": 64,
    "safe_margin_text": 96
  },
  "grid": {
    "columns": 8,
    "gutter": 32,
    "column_width": 196,
    "spacing_scale": [16, 24, 32, 48, 64, 96]
  },
  "palette": {
    "ink": "#111111",
    "lime": "#C4E538",
    "amber": "#E8A33D",
    "background": "#F4F3EF",
    "neutral": "#D9D9D4"
  },
  "color_rules": {
    "max_semantic_accents": 1,
    "lime": "money_positive_base_favorable_conclusion",
    "amber": "attention_change_raise_action",
    "neutral": "secondary_information_only",
    "character_scenes_default_accent": "lime",
    "lime_and_amber_may_compete": false
  },
  "typography": {
    "family": "Segoe UI, Arial, sans-serif",
    "headline_size": 96,
    "headline_weight": 900,
    "support_size": 48,
    "support_weight": 700,
    "label_size": 28,
    "label_weight": 800,
    "headline_size_range": [72, 96],
    "headline_weight_range": [800, 900],
    "secondary_size_range": [36, 48],
    "secondary_weight_range": [600, 800],
    "label_size_range": [24, 30],
    "label_weight_range": [600, 800],
    "headline_tracking": -1.8
  },
  "line": {
    "primary_width": 6,
    "secondary_width": 4,
    "detail_width": 3,
    "linecap": "round",
    "linejoin": "round"
  },
  "radii": {
    "large_card": [20, 24],
    "small_component": [12, 16]
  },
  "character": {
    "asset": "assets/characters/capital_oculto_character_rig_v4.svg",
    "version": 4,
    "base_symbol": "char-base",
    "part_type": "group",
    "role": "identity_not_obligation",
    "protagonist_height_range": [420, 520],
    "secondary_height_range": [280, 380],
    "minimum_height": 240,
    "allow_automatic_variants": false
  },
  "assets": {
    "reusable": ["char-base", "icons/*", "components/*", "metaphors/*"],
    "scene_root_pattern": "scene-SXXX",
    "scene_is_symbol_by_default": false
  },
  "composition": {
    "dominant_visual_ideas": 1,
    "max_context_elements": 1,
    "character_required": false,
    "dominant_element_target_area_ratio": [0.55, 0.75]
  },
  "official_layouts": {
    "A": "character_plus_metaphor",
    "B": "dominant_metaphor",
    "C": "chart_plus_headline",
    "D": "comparison_a_b",
    "E": "dominant_number_plus_support",
    "F": "progress_or_sequence"
  },
  "motion": {
    "entry_ms": [250, 400],
    "explanation_ms": [500, 900],
    "transition_ms": [250, 450],
    "idle": "minimal",
    "preferred": ["fade", "translate", "scale", "draw_reveal", "progress_fill", "counter"],
    "avoid": ["gratuitous_bounce", "exaggerated_wiggle", "random_rotation", "simultaneous_dominant_animations"],
    "max_dominant_motions_at_once": 1,
    "timing_source_of_truth": "narration_audio",
    "reference_ranges_are_mandatory_durations": false,
    "motion_requires_narrative_cue": true
  },
  "asset_integrity": {
    "geometry_source_of_truth": "assets/",
    "embed_only_used_assets": true,
    "automatic_source_copy_required": true,
    "path_mutation_during_embed_allowed": false,
    "scene_local_asset_variants_allowed": false,
    "rebuild_after_source_change": true
  },
  "continuity": {
    "declare_between_consecutive_scenes": true,
    "preserve_at_least_one_element_when_same_idea": true,
    "allowed_elements": ["position", "object", "number", "chart", "character", "motion_direction", "framing"],
    "hard_cut_requires_justification": true
  },
  "lock_policy": {
    "current_status": "candidate_sequential_test_pending",
    "lock_status": "locked_for_co_001",
    "sequential_test_scene_count": [6, 8],
    "sequential_test_duration_seconds": [20, 40],
    "automatic_system_changes_after_lock": false,
    "single_scene_exception_allowed": false,
    "resolution_order": ["change_composition", "change_layout", "simplify_metaphor"]
  },
  "validation": {
    "works_as_still": true,
    "works_without_narration": true,
    "thumbnail_scale": 0.25,
    "comprehension_seconds": 2
  }
}
