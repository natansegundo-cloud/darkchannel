    "PROTECTED_TYPE": {"layer": 50, "may_overlap": ["EXPLICIT"]},
    "STRUCTURAL_LINE": {"layer": 10},
    "CONNECTOR": {"layer": 20},
    "ARROW": {"layer": 20},
    "TRACK": {"layer": 20},
    "ACCENT_LINE": {"layer": 40},
    "DATA_MASS": {"layer": 30},
    "BACKGROUND": {"layer": 0}
  },
  "layers": {
    "background": 0,
    "structural_guides": 10,
    "tracks_baselines": 20,
    "data_masses": 30,
    "accents_highlights": 40,
    "primary_typography": 50,
    "labels_annotations": 60,
    "temporary_emphasis": 70
  },
  "protected_type": {
    "default_protect_primary_type": true,
    "padding_px": {
      "primary_headline": 24,
      "hero_number": 20,
      "secondary_label": 16,
      "micro_label": 10
