{
  "contract_id": "VISUAL_GEOMETRY_CONTRACT",
  "version": "1.0",
  "status": "STABLE",
  "canvas": {"width": 1920, "height": 1080},
  "safe_area": {"absolute_padding_px": 64, "text_padding_px": 96},
