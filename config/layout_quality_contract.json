{
  "contract_id": "LAYOUT_QUALITY_CONTRACT",
  "version": "1.0",
  "status": "STABLE",
  "canvas": {
    "width": 1920,
    "height": 1080
  },
  "safe_zone": {
    "text_padding_px": 96,
    "canvas_padding_px": 0
  },
  "measurement": {
    "engine": "BROWSER_SVG_GETBBOX",
    "fonts_ready_required": true,
    "minimum_visible_alpha": 0.12
  },
  "rules": {
    "TEXT_TEXT_OVERLAP": "ERROR",
    "TEXT_CLIPPING": "ERROR",
    "TEXT_OUTSIDE_SAFE_ZONE": "ERROR",
    "TEXT_IMPORTANT_SHAPE_OVERLAP": "ERROR",
    "INSUFFICIENT_TEXT_GAP": "WARNING",
    "CROWDING": "WARNING",
    "UNINTENTIONAL_CROP": "ERROR",
    "COMPETING_DOMINANT_ELEMENTS": "WARNING"
  },
  "minimum_gaps_px": {
    "headline_headline": 32,
    "headline_label": 24,
    "headline_graphic": 28,
    "label_graphic": 16,
    "label_label": 16,
    "hero_number_graphic": 24
  },
  "dominance": {
    "maximum_primary_dominants": 1,
    "maximum_strong_supports": 1,
    "hero_number_min_font_px": 180,
    "primary_headline_min_font_px": 96,
    "strong_support_min_font_px": 56
  },
  "sampling": {
    "scene_ratios": [0.0, 0.25, 0.5, 0.75, 1.0],
    "event_samples": ["start", "midpoint", "end"],
    "include_scene_transitions": true,
    "include_carry_over": true
  },
  "production_gate": {
    "geometry_errors": 0,
    "layout_errors": 0,
    "text_text_overlap": 0,
    "text_clipping": 0,
    "important_shape_overlap": 0
  }
}
